{
  "type": "object",
  "properties": {
    "section_basic": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "启用插件",
          "default": true
        },
        "default_kw_path": {
          "type": "string",
          "description": "默认知识库根目录（支持相对 KiraAI 根目录的相对路径，如 data/kw）",
          "default": "data/kw"
        }
      }
    },
    "section_llm": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "用于生成 wiki 页面的模型，留空用默认 LLM",
          "default": ""
        },
        "max_pages_per_ingest": {
          "type": "integer",
          "description": "单次 ingest 最多生成的页面数",
          "default": 15
        }
      }
    }
  }
}
